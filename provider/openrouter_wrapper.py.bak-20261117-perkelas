import re
import sys

# ---------------------------------------------------------------- mojibake

_HIGH = re.compile(r"[\u0080-\u00ff]+")
_MARKER = re.compile(r"[\u0080-\u009f]|Ã(?=[\u0080-\u00ff])|â(?=[\u0080-\u00ff])|Â(?=[\u0080-\u00ff])")


def count_mojibake_markers(text):
    """Count double-encoding markers: C1 control chars (never legitimate
    in prose) plus the classic Ã/â/Â lead chars of a mis-decoded run."""
    return len(_MARKER.findall(text))


def _repair_run(run):
    """Try to turn one run of high chars back into the UTF-8 text it was.
    Accept only a decode whose re-encoding reproduces the run exactly."""
    for enc in ("latin-1", "cp1252"):
        try:
            fixed = run.encode(enc).decode("utf-8")
        except (UnicodeEncodeError, UnicodeDecodeError):
            continue
        try:
            if fixed.encode("utf-8").decode(enc) == run and fixed != run:
                return fixed
        except (UnicodeEncodeError, UnicodeDecodeError):
            continue
    return run


def normalize_mojibake(text):
    """Repair double-encoded spans. Returns (clean_text, before, after)
    marker counts. Spans that do not round-trip are left untouched, so
    legitimate characters (e.g. a real '×' or '±') survive."""
    before = count_mojibake_markers(text)
    out = _HIGH.sub(lambda m: _repair_run(m.group(0)), text)
    return out, before, count_mojibake_markers(out)


