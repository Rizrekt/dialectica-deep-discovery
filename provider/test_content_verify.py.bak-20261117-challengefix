# ------------------------------------------------------------ gate

def gate_cases():
    print("== gate wiring ==")
    good = tcs.good_text()
    os.environ.pop(cnv.CONTENT_ARM_ENV, None)
    result = serve_gate.gate_answer(good)
    check("gate: unarmed -> content stage NOT performed, sendable",
          result["sendable"] is True
          and result["gate"]["content_verify"]["performed"]
          is False, f"sendable={result['sendable']}")

    def fake_block(text):
        return {"performed": True, "mode": "block",
                "verdict": "fatal", "block": True,
                "findings": [{"claim": "x"}], "unverified": [],
                "counts": {"unsupported": 1}, "stage2_calls": 1,
                "error": None}

    result = serve_gate.gate_answer(good, content_check=fake_block)
    check("gate: blocking content verdict WITHHOLDS the fixture",
          result["sendable"] is False
          and any("verifikasi isi" in r
                  for r in result["gate"]["reasons"]),
          f"sendable={result['sendable']} "
          f"reasons={result['gate']['reasons']}")

    def fake_clean(text):
        return {"performed": True, "mode": "block",
                "verdict": "clean", "block": False, "findings": [],
                "unverified": [], "counts": {}, "stage2_calls": 0,
                "error": None}

    result = serve_gate.gate_answer(good, content_check=fake_clean)
    check("gate: clean content verdict keeps the fixture sendable",
          result["sendable"] is True
          and result["gate"]["content_verify"]["verdict"]
          == "clean")

    def fake_crash(text):
        raise RuntimeError("entailment exploded")

    result = serve_gate.gate_answer(good, content_check=fake_crash)
    check("gate: crashing content callable never withholds",
          result["sendable"] is True
          and result["gate"]["content_verify"]["performed"] is False
          and result["gate"]["content_verify"]["mode"]
          == "injected-check-error")

    check("arming: unarmed helper returns None",
          serve_gate.armed_content_check() is None)
    os.environ[cnv.CONTENT_ARM_ENV] = "1"
    try:
        check("arming: DIALECTICA_CONTENT_CHECK=1 yields a callable",
              callable(serve_gate.armed_content_check()))
    finally:
        os.environ.pop(cnv.CONTENT_ARM_ENV, None)

    os.environ.pop(cnv.CONTENT_MODE_ENV, None)
    check("mode: layer default is block (not shadow)",
          cnv.content_mode() == "block")
    os.environ[cnv.CONTENT_MODE_ENV] = "shadow"
    try:
        check("mode: explicit shadow honoured",
              cnv.content_mode() == "shadow")
    finally:
        os.environ.pop(cnv.CONTENT_MODE_ENV, None)


if __name__ == "__main__":
    token_cases()
    presence_cases()
    claim_cases()
    stage1_cases()
    stage2_cases()
    failure_cases()
    gate_cases()
    print(f"\n{'ALL PASS' if not FAILURES else 'FAILURES: ' + str(FAILURES)}"
          f" ({CHECKS[0] - len(FAILURES)}/{CHECKS[0]})")
    sys.exit(1 if FAILURES else 0)
