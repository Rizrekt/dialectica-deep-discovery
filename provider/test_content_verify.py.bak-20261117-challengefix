# ------------------------------------------------------------ tokens

def token_cases():
    print("== tokens ==")
    toks = cnv.extract_precision_tokens(
        "Hunters earned 25% of the saved tokens, about 869,566 HOP, "
        "a 2.5 fold rise, fees of $1.5 million, on August 8, 2022.")
    kinds = {(t.raw, t.kind, t.strong) for t in toks}
    check("tokens: percent strong", ("25%", "percent", True) in kinds,
          f"{kinds}")
    check("tokens: grouped strong",
          ("869,566", "grouped", True) in kinds, f"{kinds}")
    check("tokens: decimal strong", ("2.5", "decimal", True) in kinds,
          f"{kinds}")
    check("tokens: currency strong",
          any(k[1] == "currency" and k[2] for k in kinds), f"{kinds}")
    check("tokens: full date strong",
          ("August 8, 2022", "date", True) in kinds, f"{kinds}")
    toks = cnv.extract_precision_tokens(
        "Per RFC 5233 and BIP-32 (2012), see ePrint 2020/940.")
    check("tokens: identifiers masked, year weak only",
          [(t.kind, t.strong) for t in toks] == [("year", False)],
          f"{[(t.raw, t.kind) for t in toks]}")
    toks = cnv.extract_precision_tokens(
        "hunters were promised twenty five percent of tokens")
    check("tokens: spelled percent phrase (partial words)",
          any(t.kind == "percent" for t in toks), f"{toks}")
    toks = cnv.extract_precision_tokens(
        "hunters were promised fifty percent of the tokens")
    check("tokens: spelled-out percent strong",
          any(t.kind == "percent" and t.strong for t in toks),
          f"{[(t.raw, t.kind) for t in toks]}")


def presence_cases():
    print("== presence ==")
    src = cnv._fold("Hunters were promised 25% of all tokens, "
                    "about 869566 HOP, decided August 8, 2022.")
    t = cnv.PrecisionToken("25%", "percent", "25", True, (0, 3))
    check("presence: percent found with % context",
          cnv._token_present(t, src) is not None)
    t2 = cnv.PrecisionToken("50%", "percent", "50", True, (0, 3))
    check("presence: absent percent NOT found",
          cnv._token_present(t2, src) is None)
    bare = cnv._fold("over 50 wallets were flagged in 2022")
    check("presence: bare '50' does NOT satisfy a percent token",
          cnv._token_present(t2, bare) is None)
    g = cnv.PrecisionToken("869,566", "grouped", "869566", True,
                           (0, 7))
    check("presence: grouped digits match separator-stripped",
          cnv._token_present(g, src) is not None)
    d = cnv.PrecisionToken("August 8, 2022", "date", "2022-08-08",
                           True, (0, 14))
    check("presence: date matches MDY form",
          cnv._token_present(d, src) is not None)
    check("presence: date matches ISO form",
          cnv._token_present(d, cnv._fold("log 2022-08-08 entry"))
          is not None)
    w = cnv.PrecisionToken("25%", "percent", "25", True, (0, 3))
    check("presence: spelled-out percent in source matches",
          cnv._token_present(
              w, cnv._fold("hunters got twenty five percent back"))
          is not None or cnv._token_present(
              w, cnv._fold("a 25 percent share")) is not None)


# ------------------------------------------------------------ claims

def claim_cases():
    print("== claims ==")
    claims, _ = cnv.extract_claims(HOP_DRAFT)
    hop = [c for c in claims if "Hop" in c.sentence]
    check("claims: Hop assertion extracted once (closing dupe "
          "merged)", len(hop) == 1, f"{len(claims)} claims")
    if hop:
        c = hop[0]
        check("claims: Hop claim pivotal (figure + precedent)",
              c.pivotal and "T1-precision-figure" in c.pivotal_reasons
              and "T2-precedent-marker" in c.pivotal_reasons,
              f"{c.pivotal_reasons}")
        check("claims: Hop claim paired with docs.hop pointer",
              any("hop.exchange" in p.value for p in c.pointers),
              f"{[p.value for p in c.pointers]}")
    draft = ("A figure of 42% appears with no source at all in "
             "this sentence.")
    claims, _ = cnv.extract_claims(draft)
    check("claims: unbound precision claim recorded, not paired",
          len(claims) == 1 and not claims[0].pointers)
    draft = ("Body claim: adoption rose 30% last year "
             "(https://example.com/report).\n\n## Sources\n\n"
             "- Example — https://example.com/report restates 30% "
             "and 99% figures.")
    claims, _ = cnv.extract_claims(draft)
    check("claims: Sources-section lines generate no claims",
          len(claims) == 1 and "99%" not in claims[0].sentence,
          f"{[c.sentence[:50] for c in claims]}")
    draft = ('Douceur ("The Sybil Attack," IPTPS 2002, '
             "https://link.springer.com/chapter/10.1007/"
             "3-540-45748-8_24) frames the field.")
    claims, _ = cnv.extract_claims(draft)
    toks = claims[0].tokens if claims else []
    check("claims: figures inside a cited URL are not tokens",
          all(t.kind != "decimal" for t in toks),
          f"{[(t.raw, t.kind) for t in toks]}")


# ------------------------------------------------------------ stage 1

def stage1_cases():
    print("== stage 1 ==")
    out = run(HOP_DRAFT, {HOP_URL: ok(HOP_URL, HOP_HOME)},
              model_call=lambda prompt: json.dumps(
                  {"verdict": "unsupported", "evidence": "",
                   "why": "source never mentions the scheme"}))
    check("stage1+2: Hop pattern is FATAL and blocks in block mode",
          out["verdict"] == "fatal" and out["block"] is True,
          f"{out['verdict']} block={out['block']}")
    hop = [c for c in out["claims"] if "Hop" in c["claim"]]
    check("stage1: Hop tokens 50%/10% marked NOT found in source",
          hop and all(t["found"] is False for t in hop[0]["tokens"]
                      if t["kind"] == "percent"),
          f"{hop[0]['tokens'] if hop else None}")
    out = run(HOP_DRAFT, {HOP_URL: ok(HOP_URL, HOP_HOME)},
              model_call=lambda prompt: json.dumps(
                  {"verdict": "unsupported", "evidence": "",
                   "why": "x"}), mode="shadow")
    check("shadow: Hop pattern fatal verdict but NEVER blocks",
          out["verdict"] == "fatal" and out["block"] is False)
    healthy = ("The documented scheme promised hunters 25% of the "
               "tokens they saved (Hop Protocol, "
               "docs.hop.exchange).")
    home25 = ("<html><body>Hop sybil hunters were promised 25% of "
              "all HOP tokens saved.</body></html>")
    out = run(healthy, {HOP_URL: ok(HOP_URL, home25)},
              model_call=lambda prompt: json.dumps(
                  {"verdict": "supported",
                   "evidence": "promised 25% of all HOP tokens",
                   "why": "figure stated"}))
    check("stage1: source carrying the figure supports the claim",
          out["verdict"] in ("clean", "findings")
          and out["block"] is False,
          f"{out['verdict']}")
    out = run(HOP_DRAFT,
              {HOP_URL: cv.FetchResult(HOP_URL, status=403,
                                       text="bot wall")})
    check("stage1: bot-walled source -> claim UNVERIFIABLE class, "
          "no block", out["verdict"] == "unverified"
          and out["block"] is False, f"{out['verdict']}")
    out = run(HOP_DRAFT,
              {HOP_URL: cv.FetchResult(HOP_URL, status=404)})
    hop = [c for c in out["claims"] if "Hop" in c["claim"]]
    check("stage1: dead source -> no-source class, not a content "
          "conviction", hop and hop[0]["source_status"] == "dead"
          and out["block"] is False,
          f"{hop[0]['source_status'] if hop else None} "
          f"verdict={out['verdict']}")


# ------------------------------------------------------------ stage 2

def stage2_cases():
    print("== stage 2 ==")
    # Rescue: stage 1 misses (the source states the figure as
    # "a quarter" — no percent form for the normaliser to find);
    # stage 2 reads the excerpt and supports it with a verbatim
    # quote.
    draft = ("Hunters kept 25% of the allocation "
             "(https://example.com/scheme).")
    url = "https://example.com/scheme"
    src = ("<html><body>Hunters kept a quarter of the allocation "
           "for themselves.</body></html>")
    out = run(draft, {url: ok(url, src)},
              model_call=lambda prompt: json.dumps(
                  {"verdict": "supported",
                   "evidence": "Hunters kept a quarter of the "
                               "allocation",
                   "why": "a quarter = 25%"}))
    claim = out["claims"][0] if out["claims"] else {}
    check("stage2: supported + verbatim evidence settles claim",
          claim.get("final") == "supported"
          and out["block"] is False,
          f"{claim.get('stage1')}/{claim.get('stage2')}/"
          f"{claim.get('final')}")
    out = run(draft, {url: ok(url, src)},
              model_call=lambda prompt: json.dumps(
                  {"verdict": "supported", "evidence": "invented "
                   "quote not in source", "why": "trust me"}))
    claim = out["claims"][0] if out["claims"] else {}
    check("stage2: supported WITHOUT verifiable quote degrades "
          "to unclear", claim.get("stage2") == "unclear",
          f"{claim.get('stage2')}")
    out = run(HOP_DRAFT, {HOP_URL: ok(HOP_URL, HOP_HOME)},
              model_call=lambda prompt: json.dumps(
                  {"verdict": "unclear", "evidence": "",
                   "why": "fragmentary"}))
    check("stage2: unclear does NOT rescue a stage-1 finding — "
          "mechanical absence stands, fatal in block mode",
          out["verdict"] == "fatal" and out["block"] is True,
          f"{out['verdict']}")
    many = "\n\n".join(
        f"Scheme {i} paid hunters {10 + i}% of saved tokens "
        f"(https://example.com/s{i})." for i in range(8))
    routes = {f"https://example.com/s{i}":
              ok(f"https://example.com/s{i}", "<html>home</html>")
              for i in range(8)}
    out = run(many, routes,
              model_call=lambda prompt: json.dumps(
                  {"verdict": "unsupported", "evidence": "",
                   "why": "absent"}))
    check("stage2: budget cap honoured, skips recorded",
          out["stage2_calls"] == cnv.MAX_STAGE2_CALLS
          and any(c["stage2"] == "skipped-budget"
                  for c in out["claims"]),
          f"calls={out['stage2_calls']}")
    def boom(prompt):
        raise RuntimeError("lane down")
    out = run(HOP_DRAFT, {HOP_URL: ok(HOP_URL, HOP_HOME)},
              model_call=boom)
    check("stage2: raising lane leaves stage-1 verdict standing "
          "and is reported", out["verdict"] == "fatal"
          and out["error"] and "lane down" in out["error"],
          f"{out['verdict']} err={out['error']}")


