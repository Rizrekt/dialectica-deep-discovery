        "author": [{"family": "Meiklejohn"}]}}))}


class FakeFetcher:
    """Deterministic fetcher seam (same contract as the citation
    tests): routes map URL -> FetchResult; a missing route is a
    connection failure."""

    def __init__(self, routes):
        self.routes = dict(routes)
        self.calls = 0
        self.connect_failures = 0
        self._cache = {}

    def get(self, url):
        if url in self._cache:
            return self._cache[url]
        self.calls += 1
        result = self.routes.get(url)
        if result is None:
            result = cv.FetchResult(url, error="no route",
                                    error_kind="connect")
        if result.error_kind == "connect":
            self.connect_failures += 1
        self._cache[url] = result
        return result


def ok(url, text):
    return cv.FetchResult(url, status=200, text=text)


def no_model(prompt):
    raise AssertionError("model must not be called in this case")


def run(draft, routes, model_call=None, mode="block", **kw):
    fetcher = FakeFetcher({**CANARY_OK, **routes})
    return cnv.verify_content(
        draft, fetcher=fetcher,
        model_call=model_call if model_call is not None else no_model,
        mode=mode, log_path=None, **kw)


