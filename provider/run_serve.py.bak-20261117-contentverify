def supervise_serve(proc, count_fn, cap, poll_s=SUPERVISOR_POLL_S,
                    drain_timeout_s=SUPERVISOR_DRAIN_TIMEOUT_S):
    """Watch a `trued serve` child until it exits, the operator stops
    us, or the serve generation cap is reached (§39).

    - Cap reached -> SIGINT the child (trued's own graceful shutdown:
      stop claiming, drain in-flight work), wait for the drain, and
      return the child's exit code. The caller never relaunches.
    - SIGINT/SIGTERM to the supervisor is forwarded to the child and
      the supervisor waits for it — the child is never orphaned.
    """
    received = {"sig": None}

    def _forward(signum, _frame):
        received["sig"] = signum

    old_int = signal.signal(signal.SIGINT, _forward)
    old_term = signal.signal(signal.SIGTERM, _forward)
    try:
        while True:
            rc = proc.poll()
            if rc is not None:
                return rc
            sig = received["sig"]
            capped = False
            if sig is None:
                try:
                    capped = count_fn() >= cap
                except Exception:  # noqa: BLE001 - a bad count read
                    capped = False  # must not kill a healthy serve
            if sig is not None or capped:
                if capped:
                    print(f"run_serve: serve generation cap reached "
                          f"({cap}/day UTC) — SIGINT to trued serve "
                          f"(graceful drain); NOT relaunching today",
                          flush=True)
                else:
                    print(f"run_serve: signal {sig} received — "
                          f"forwarding to trued serve", flush=True)
                proc.send_signal(sig if sig is not None
                                 else signal.SIGINT)
                deadline = time.monotonic() + drain_timeout_s
                while proc.poll() is None:
                    if time.monotonic() >= deadline:
                        print("run_serve: drain exceeded "
                              f"{drain_timeout_s}s — escalating to "
                              f"SIGTERM/SIGKILL", flush=True)
                        proc.terminate()
                        try:
                            proc.wait(timeout=10)
                        except subprocess.TimeoutExpired:
                            proc.kill()
                        break
                    time.sleep(1)
                return proc.wait()
            time.sleep(poll_s)
    finally:
        signal.signal(signal.SIGINT, old_int)
        signal.signal(signal.SIGTERM, old_term)


def _run_cloudflare_serve(argv, dry_run):
    """§39 supervised Pioneer serve on the Cloudflare lane. Returns
    the process exit code; launches nothing in dry-run, and refuses
    to start (exit 6) when today's serve generation cap is already
    reached — a keyword rotation cannot resurrect a capped day."""
    here = os.path.dirname(os.path.abspath(__file__))
    if here not in sys.path:
        sys.path.insert(0, here)
    import cloudflare_serve_common as csc

    provider = os.path.join(here, CLOUDFLARE_SERVE_PROVIDER)
    prepare = os.path.join(here, CLOUDFLARE_SERVE_PREPARE)
    ready = os.path.join(here, CLOUDFLARE_SERVE_READY)
    serve_every = os.environ.get("SERVE_EVERY", "").strip()
    args = (["python3", TRUED, "serve"]
            + (["--every", serve_every] if serve_every else []) + argv)
    count = csc.serve_generations_today()
    if dry_run:
        print("run_serve: DRY-RUN provider=cloudflare mode=serve-pioneer (§39)")
        print(f"run_serve: DIALECTICA_PROVIDER_CMD=python3 {provider}")
        print(f"run_serve: DIALECTICA_PREPARE_CMD=python3 {prepare}")
        print(f"run_serve: DIALECTICA_READY_CMD=python3 {ready}")
        print(f"run_serve: {SERVE_GATE_FETCH_ENV}=1 (serve gate "
              f"liveness armed, serve_gate.py)")
        print("run_serve: credential env: none injected (connector "
              "client fetches custom.cloudflare-workers-ai itself)")
        print(f"run_serve: serve generations today (UTC): "
              f"{count}/{csc.SERVE_CAP} — supervisor SIGINTs trued at "
              f"the cap and never relaunches; start refused at cap")
        print(f"run_serve: would exec: {' '.join(args)}")
        print("run_serve: DRY-RUN — nothing launched, nothing submitted")
        return 0
    if count >= csc.SERVE_CAP:
        print(f"run_serve: REFUSED — serve generation cap for today "
              f"(UTC) already reached ({count}/{csc.SERVE_CAP}); "
              f"serve does not start again today (§39)",
              file=sys.stderr)
        return EXIT_SERVE_CAP_REACHED
    env = dict(os.environ)
    env["DIALECTICA_PROVIDER_CMD"] = f"python3 {provider}"
    env["DIALECTICA_PREPARE_CMD"] = f"python3 {prepare}"
    env["DIALECTICA_READY_CMD"] = f"python3 {ready}"
    env[SERVE_GATE_FETCH_ENV] = "1"
    print(f"run_serve: launching trued serve provider=cloudflare "
          f"mode=serve-pioneer (§39) every={serve_every or 'client-default'} "
          f"serve generations today: {count}/{csc.SERVE_CAP}", flush=True)
    proc = subprocess.Popen(args, env=env)
    rc = supervise_serve(proc, csc.serve_generations_today, csc.SERVE_CAP)
    print(f"run_serve: trued exited rc={rc}", flush=True)
    return rc


