        wrapper_file = ANSWER_ONLY_LANES[name][0]
        conn, env_key = ANSWER_ONLY_LANES[name][1], None
    else:
        conn, env_key, wrapper_file = PROVIDERS[name]
    wrapper = os.path.expanduser(
        f"~/workspace/research/dialectica/provider/{wrapper_file}")
    if dry_run:
        serve_every = os.environ.get("SERVE_EVERY", "").strip()
        would = (["python3", TRUED, "answer"] if mode == "answer" else
                 ["python3", TRUED, "serve"]
                 + (["--every", serve_every] if serve_every else [])) + argv
        print(f"run_serve: DRY-RUN provider={name} mode={mode}")
        print(f"run_serve: DIALECTICA_PROVIDER_CMD=python3 {wrapper}")
        if name == "vyce" and mode == "serve":
            here = os.path.dirname(os.path.abspath(__file__))
            print("run_serve: gated Vyce serve overrides (2026-11-15):")
            print(f"run_serve: DIALECTICA_PROVIDER_CMD=python3 "
                  f"{os.path.join(here, VYCE_SERVE_PROVIDER)}")
            print(f"run_serve: DIALECTICA_PREPARE_CMD=python3 "
                  f"{os.path.join(here, VYCE_SERVE_PREPARE)}")
            print(f"run_serve: DIALECTICA_READY_CMD=python3 "
                  f"{os.path.join(here, VYCE_SERVE_READY)}")
            print(f"run_serve: {SERVE_GATE_FETCH_ENV}=1 (serve gate "
                  f"liveness armed, serve_gate.py)")
        if env_key:
            print(f"run_serve: credential env {env_key} would be set "
                  f"from connector {conn} (value NOT fetched in dry-run)")
        else:
            print("run_serve: credential env: none injected (connector "
                  f"client fetches {conn} itself)")
        print(f"run_serve: would exec: {' '.join(would)}")
        print("run_serve: DRY-RUN — nothing launched, nothing submitted")
        return 0
    env = dict(os.environ)
    if env_key:
        entry = dynamic_credential_entry(conn, "access_token")
        env[env_key] = str(entry["surrogate"])
    if name == "vyce":
        try:
            g = dynamic_credential_entry("custom.google-gemini", "access_token")
            env["GEMINI_KEY_FALLBACK"] = str(g["surrogate"])
        except Exception:
            pass
    env["DIALECTICA_PROVIDER_CMD"] = f"python3 {wrapper}"
    if name == "vyce" and mode == "serve":
        # Gated Vyce serve (2026-11-15): mirror the §39 hook shape so
        # no serve answer can reach the server ungated — prepare
        # generates + gates BEFORE any claim, ready vetoes unprepared
        # bids, provider serves the prepared cache. --answer mode is
