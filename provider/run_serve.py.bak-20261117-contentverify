        here = os.path.dirname(os.path.abspath(__file__))
        env["DIALECTICA_PROVIDER_CMD"] = (
            f"python3 {os.path.join(here, VYCE_SERVE_PROVIDER)}")
        env["DIALECTICA_PREPARE_CMD"] = (
            f"python3 {os.path.join(here, VYCE_SERVE_PREPARE)}")
        env["DIALECTICA_READY_CMD"] = (
            f"python3 {os.path.join(here, VYCE_SERVE_READY)}")
        env[SERVE_GATE_FETCH_ENV] = "1"
        env[SEMANTIC_CHECK_ENV] = "1"
        env[CITATION_CHECK_ENV] = "1"
        env[FRESHNESS_CHECK_ENV] = "1"
        print("run_serve: gated Vyce serve — prepare/ready hooks + "
              "serve gate armed (liveness, wrapper, thinking-trace, "
              "semantik C5 mode dari DIALECTICA_SEMANTIC_MODE, "
              "default shadow; verifikasi sitasi mekanis mode dari "
              "DIALECTICA_CITATION_MODE, default block; cek-ulang "
              "kesegaran detik-kirim mode dari "
              "DIALECTICA_FRESHNESS_MODE, default block)",
              flush=True)
    if mode == "answer":
        args = ["python3", TRUED, "answer"] + argv
        print(f"run_serve: launching trued answer provider={name}", flush=True)
    else:
        serve_every = os.environ.get("SERVE_EVERY", "").strip()
        args = ["python3", TRUED, "serve"] + (["--every", serve_every] if serve_every else []) + argv
        print(f"run_serve: launching trued serve provider={name} every={serve_every or 'client-default'}", flush=True)
    proc = subprocess.run(args, env=env)
    # Exit code is EVIDENCE (answer: 0 accepted / 1 failed / 3 unknown /
    # 4 passed-on). Print it loudly; never let it pass silently again.
    print(f"run_serve: trued exited rc={proc.returncode}", flush=True)
    return proc.returncode


