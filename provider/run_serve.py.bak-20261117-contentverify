        # included. The single exception is the explicit supervised
        # §39 mode (--cloudflare-serve), handled below.
        print(f"run_serve: REFUSED — {ANSWER_ONLY_LANES[name][2]}",
              file=sys.stderr)
        return EXIT_SERVE_FORBIDDEN
    if cf_serve:
        return _run_cloudflare_serve(argv, dry_run)
