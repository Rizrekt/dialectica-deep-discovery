    elif "--dashscope" in argv:
        name = "dashscope"
    elif "--zai" in argv:
        name = "zai"
    elif "--gemini" in argv:
        name = "gemini"
    else:
        name = "vyce"
    argv = [a for a in argv
            if a not in ("--gemini", "--openrouter", "--cloudflare",
                         "--cloudflare-serve", "--dashscope", "--zai")]
    mode = "answer" if "--answer" in argv else "serve"
    argv = [a for a in argv if a != "--answer"]
