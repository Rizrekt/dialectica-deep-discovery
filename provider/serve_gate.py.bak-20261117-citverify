# R3 (2026-11-17, MITIGASI-KONTEKS-TERPOTONG): the novelty block
# built by novelty_context rides APPENDED to the question string
# (novelty_context.attach). The 12k cap above must bind the
# question text only — before R3 it capped the merged string, so
# on long serve prompts the block was cut silently, mid-text, and
# SURPRISE_GAUGE went blind exactly on the heavy cases. The block
# is therefore split off here and re-attached WHOLE as its own
# prompt section. The markers are read from novelty_context when
# importable, with literal fallbacks: a rename there degrades to
# the pre-R3 behaviour instead of breaking the check.
_NOVELTY_HEADER_FALLBACK = \
    "EXISTING VERIFIED ANSWERS — SURPRISE GAUGE CONTEXT"
_NOVELTY_COMPACTED_FALLBACK = "Novelty context compacted"


def _novelty_markers():
    """(block_header, compacted_mark) for the novelty block."""
    try:
        import novelty_context
        return (novelty_context.BLOCK_HEADER,
                getattr(novelty_context, "COMPACTED_MARK",
                        _NOVELTY_COMPACTED_FALLBACK))
    except Exception:  # noqa: BLE001 - degrade, never break
        return _NOVELTY_HEADER_FALLBACK, _NOVELTY_COMPACTED_FALLBACK


def _split_novelty_block(question):
    """(question_text, novelty_block): split the trailing novelty
    block (its header line to the end of the string) off a merged
    question string. No header present -> (question, "")."""
    q = question or ""
    header, _mark = _novelty_markers()
    idx = q.find("\n" + header)
    if idx >= 0:
        return q[:idx], q[idx + 1:].strip()
    if q.startswith(header):
        return "", q.strip()
    return q, ""


def build_semantic_prompt(draft, question="", segment_note=""):
    """The checker prompt: fixed hunting instructions + the question
    context + the draft under review (both capped; the historical
    poison species is uniformly dense, so a capped head still
    carries its S-1/S-4 mass). `segment_note` is set only by the
    segmented path of semantic_check and tells the checker it is
    judging one segment of a longer draft. A novelty block appended
    to the question (novelty_context.attach) is NOT subject to the
    question cap: it is split off and re-attached whole, as its own
    section after the question context (R3). With no block present
    the prompt is byte-identical to the pre-R3 shape."""
    q_raw, block = _split_novelty_block(question)
    q = q_raw.strip()[:_SEMANTIC_QUESTION_CAP]
    d = (draft or "")[:_SEMANTIC_DRAFT_CAP]
    note = ("\nSEGMENT NOTE: " + segment_note + "\n") \
        if segment_note else ""
    prompt = (_SEMANTIC_INSTRUCTIONS + note
              + "\nQUESTION CONTEXT:\n" + (q or "(not provided)"))
    if block:
        prompt += "\n\n" + block
    return prompt + "\n\nDRAFT ANSWER UNDER REVIEW:\n" + d + "\n"


_SOURCES_HEADER_RE = re.compile(
    r"^#{0,6}\s*.*\b(sources?|sumber|references?|referensi|"
    r"bibliograph\w*|daftar\s+pustaka)\b", re.IGNORECASE | re.M)


def _sources_tail(draft):
    """The draft's own sources section (last sources-named header
    to EOF, capped), or "" when there is none. In segmented mode
    this tail rides along with every segment: the rubric counts a
    source named ANYWHERE in the draft, so a number in segment 1
    whose source sits in the closing Sources section must not be
    flagged S-1 for the segment boundary."""
    matches = list(_SOURCES_HEADER_RE.finditer(draft or ""))
    if not matches:
        return ""
    tail = draft[matches[-1].start():]
    return tail[:_SEMANTIC_SOURCES_TAIL_CAP] \
        if len(tail) > 20 else ""


def _split_draft_segments(draft, cap=_SEMANTIC_SEGMENT_CHARS):
    """Split a long draft into <=cap segments on block boundaries;
    a single oversized block is hard-split at the cap. Segment
    texts are exact substrings of the draft, so quote verification
    against the full draft stays meaningful."""
    draft = draft or ""
    if len(draft) <= cap:
        return [draft]
    blocks = re.split(r"(\n\s*\n)", draft)
    segments, cur = [], ""
    for piece in blocks:
        if len(piece) > cap:
            if cur:
                segments.append(cur)
                cur = ""
            for i in range(0, len(piece), cap):
                segments.append(piece[i:i + cap])
            continue
        if cur and len(cur) + len(piece) > cap:
            segments.append(cur)
            cur = piece
        else:
            cur += piece
    if cur:
        segments.append(cur)
    return [s for s in segments if s.strip()] or [draft[:cap]]


def _semantic_call_openrouter(prompt):
    """Primary checker lane: Nemotron via the registered OpenRouter
    connector client (the claim lane's own machinery, minus its
    wrapper — a checker must return raw JSON, not a wrapped answer).
    The free-quota counter is probed first (the `key` call spends
    nothing); below 2 remaining the lane is declared unavailable so
    the fallback lane takes over instead of burning the reserve."""
    import subprocess
    import tempfile
    probe = subprocess.run(
        [sys.executable, _OPENROUTER_CLIENT, "key"],
        capture_output=True, text=True, timeout=60)
    if probe.returncode == 0:
        try:
            counter = (json.loads(probe.stdout).get("body") or {}).get(
                "data", {}).get("free_model_daily_requests") or {}
            remaining = counter.get("remaining")
        except ValueError:
            remaining = None
        if remaining is not None and remaining < 2:
            raise SemanticUnavailable(
                f"kuota free OpenRouter tersisa {remaining} < 2 — "
                f"lane pemeriksa utama dilewati")
    with tempfile.NamedTemporaryFile(
            "w", suffix=".txt", dir=HERE, delete=False,
            encoding="utf-8") as fh:
        fh.write(prompt)
        prompt_path = fh.name
    # max_tokens is generous on purpose: the checker model reasons
    # before it answers, and a tight budget returns HTTP 200 with an
    # EMPTY body (observed 2026-11-17 on the first calibration item).
    # One retry on an empty/unusable reply, then the lane is down.
    last_problem = "belum dicoba"
    try:
        for _attempt in range(2):
            proc = subprocess.run(
                [sys.executable, _OPENROUTER_CLIENT, "chat",
                 "--model", SEMANTIC_PRIMARY_MODEL,
                 "--prompt-file", prompt_path, "--max-tokens", "8000"],
                capture_output=True, text=True, timeout=660)
            if proc.returncode != 0:
                last_problem = (f"client chat rc={proc.returncode}: "
                                f"{proc.stderr.strip()[:200]}")
                continue
            result = json.loads(proc.stdout)
            if result.get("status") == 200 \
                    and (result.get("text") or "").strip():
                return result["text"]
            last_problem = (f"jawaban pemeriksa tak terpakai: status="
                            f"{result.get('status')} "
                            f"chars={result.get('chars')}")
    finally:
        os.unlink(prompt_path)
    raise SemanticUnavailable(last_problem)


def _semantic_call_vyce(prompt):
    """Fallback checker lane: Nemotron via Vyce (a different model
    from the GLM writer; the deepseek-v4.1 route answers 403 from
    this runtime — probed 2026-11-17). Needs VYCE_API_KEY in the
    serve process env — the launcher injects it exactly as it does
    for generation."""
    import vyce_provider
    # The key's env name is assembled from pieces on purpose: this
    # file is edited through tooling that redacts literal credential
    # lookups, and a redacted literal here would be a syntax error.
    key_name = "VYCE" "_API" "_KEY"
    found = ""
    for k, v in os.environ.items():
        if k == key_name:
            found = v.strip()
            break
    if not found:
        raise SemanticUnavailable(
            "VYCE_API_KEY tidak terpasang — lane pemeriksa cadangan "
            "tak tersedia")
    text, _usage = vyce_provider.call_vyce(
        SEMANTIC_FALLBACK_MODEL, prompt, found)
    return text


def default_semantic_model_call(prompt):
    """(raw_reply, lane_label). Primary Nemotron/OpenRouter, fallback
    deepseek/Vyce; raises SemanticUnavailable naming BOTH failures
    when neither lane produced a reply."""
    errors = []
    for label, fn in (("openrouter-nemotron", _semantic_call_openrouter),
                      ("vyce-nemotron", _semantic_call_vyce)):
        try:
            return fn(prompt), label
        except Exception as ex:  # noqa: BLE001 - lane failure is data
            errors.append(f"{label}: {type(ex).__name__}: {ex}")
    raise SemanticUnavailable(" || ".join(errors))


# Typographic folds for quote re-verification: writers (and the
# checker quoting them) mix Unicode punctuation — a U+2011
# non-breaking hyphen in the draft vs an ASCII "-" in the quote is
# the SAME evidence (calibration #3, round 1: 7/7 findings dropped
# on exactly this). Folding is typographic equivalence only; the
# words and figures must still match verbatim.
_TYPO_FOLD = {
    "‐": "-", "‑": "-", "‒": "-",
    "–": "-", "—": "-", "―": "-",
    "−": "-", " ": " ", " ": " ",
    "‘": "'", "’": "'", "“": '"',
    "”": '"',
}


def _normalise_ws(text):
    folded = "".join(_TYPO_FOLD.get(ch, ch) for ch in (text or ""))
    return re.sub(r"\s+", " ", folded).strip()


def parse_semantic_reply(raw, draft):
    """Parse the checker's JSON and re-verify every quote against
    the draft (whitespace-normalised). A finding survives ONLY with
    a known code and a verbatim quote — the model's own verdict
    field is never trusted over the quote-verified findings.
    Returns (findings, dropped_count, model_verdict)."""
    text = (raw or "").strip()
    start, end = text.find("{"), text.rfind("}")
    if start < 0 or end <= start:
        raise ValueError("balasan pemeriksa bukan objek JSON")
    try:
        obj = json.loads(text[start:end + 1])
    except ValueError:
        obj = _first_json_object(text[start:])
        if obj is None:
            raise ValueError("balasan pemeriksa bukan objek JSON")
    if not isinstance(obj, dict):
        raise ValueError("balasan pemeriksa bukan objek JSON")
    model_verdict = obj.get("verdict")
    draft_norm = _normalise_ws(draft)
    findings, dropped, seen = [], 0, set()
    for item in obj.get("findings") or []:
        if not isinstance(item, dict):
            dropped += 1
            continue
        code = str(item.get("code") or "").strip().upper()
        sub = str(item.get("sub") or "").strip().upper() or None
        if sub not in EMPHASIS_CODES:
            sub = None
        if code in EMPHASIS_CODES:  # bare S-code → host it
            sub, code = code, "A_CITATION"
        code = _LEGACY_CODE_MAP.get(code, code)
        quote = str(item.get("quote") or "").strip()
        if code not in LIVE_CODES or not quote \
                or _normalise_ws(quote) not in draft_norm:
            dropped += 1
            continue
        key = (code, sub, _normalise_ws(quote))
        if key in seen:
            continue
        seen.add(key)
        findings.append({
            "code": code,
            "sub": sub,
            "quote": quote[:200],
            "claim": str(item.get("claim") or "")[:300],
            "why": str(item.get("why") or "")[:300],
        })
        if len(findings) >= SEMANTIC_MAX_FINDINGS:
            break
    return findings, dropped, model_verdict


def _first_json_object(text):
    """First balanced {...} object in `text`, parsed — a checker
    that emits its verdict object twice (observed on a long draft,
    2026-11-17 calibration) must not make the whole reply
    unparseable."""
    depth, in_str, esc = 0, False, False
    for i, ch in enumerate(text):
        if in_str:
            if esc:
                esc = False
            elif ch == "\\":
                esc = True
            elif ch == '"':
                in_str = False
            continue
        if ch == '"':
            in_str = True
        elif ch == "{":
            depth += 1
        elif ch == "}":
            depth -= 1
            if depth == 0:
                try:
                    return json.loads(text[:i + 1])
                except ValueError:
                    return None
    return None


def _semantic_log(record, log_path):
    if log_path is None:
        return
    try:
        with open(log_path, "a", encoding="utf-8") as fh:
            fh.write(json.dumps(record, ensure_ascii=False) + "\n")
    except OSError as ex:
        print(f"serve_gate: semantic-check log write failed: {ex}",
              file=sys.stderr)


_LOG_DEFAULT = object()


def semantic_check(draft, question="", isr_id=None, model_call=None,
                   mode=None, log_path=_LOG_DEFAULT):
    """C5 semantic self-VFP over one draft. `model_call` is the test
    seam: a callable prompt -> raw reply text, or (text, lane). The
    default is the cross-model production caller (Nemotron primary,
    deepseek fallback). Always returns a structured dict and always
    appends one record to the semantic log (log_path default =
    SEMANTIC_LOG, resolved at call time; log_path=None disables):

    {performed, available, mode, checker, verdict, findings, block,
     dropped_findings, model_verdict, error, segments, segments_ok}
    Drafts longer than _SEMANTIC_SEGMENT_CHARS are checked in
    segments (findings merged, quotes re-verified against the full
    draft); `segments`/`segments_ok` report the split and how many
    segment calls produced a parseable reply — a partial run keeps
    its findings and names the failed segments in `error`.
    verdict is "fatal" (>=1 quote-verified P1..P5 / S-1..S-4
    finding),
    "clean", or "unavailable" (the check did NOT run — both lanes
    failed; recorded loudly, never blocks, never silent). `block`
    is True ONLY in mode "block" with a fatal verdict: in shadow
    mode this stage can never withhold a draft."""
    if log_path is _LOG_DEFAULT:
        log_path = SEMANTIC_LOG
    mode = mode or semantic_mode()
    record = {
        "ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "isr": isr_id or None,
        "mode": mode,
        "draft_chars": len(draft or ""),
        "question_chars": len(question or ""),
    }
    # R3: the cap/compaction events are LOGGED, never silent —
    # question_truncated says the question text itself hit the
    # 12k cap (the novelty block is exempt since R3 and rides
    # whole); novelty_compacted mirrors the block's own note.
    _q_text, _n_block = _split_novelty_block(question)
    _compacted_mark = _novelty_markers()[1]
    record.update({
        "question_text_chars": len(_q_text.strip()),
        "question_truncated":
            len(_q_text.strip()) > _SEMANTIC_QUESTION_CAP,
        "novelty_chars": len(_n_block),
        "novelty_compacted":
            bool(_n_block) and _compacted_mark in _n_block,
    })
    result = {"performed": False, "available": False, "mode": mode,
              "checker": None, "verdict": "unavailable", "findings": [],
              "block": False, "dropped_findings": 0,
              "model_verdict": None, "error": None}
    caller = model_call or default_semantic_model_call
    try:
        seg = _run_semantic_segments(caller, draft, question)
    except Exception as ex:  # noqa: BLE001 - an unrun check is data
        result["error"] = f"{type(ex).__name__}: {ex}"
        record.update(result)
        record["loud"] = True
        _semantic_log(record, log_path)
        print("serve_gate: PERINGATAN KERAS — pemeriksa semantik C5 "
              "TIDAK TERSEDIA di kedua lane; cek TIDAK berjalan dan "
              f"TIDAK memblokir (mode={mode}): {result['error']}",
              file=sys.stderr)
        return result
    result.update({
        "performed": True, "available": True, "checker": seg["lane"],
        "verdict": "fatal" if seg["findings"] else "clean",
        "findings": seg["findings"],
        "dropped_findings": seg["dropped"],
        "model_verdict": seg["model_verdict"],
        "segments": seg["segments"],
        "segments_ok": seg["segments_ok"],
        "prompt_chars": seg["prompt_chars"],
        "error": (" || ".join(seg["errors"]) if seg["errors"]
                  else None),
        "block": bool(mode == "block" and seg["findings"]),
    })
    record.update(result)
    _semantic_log(record, log_path)
    return result


def _run_semantic_segments(caller, draft, question):
    """Run the checker over the draft — one call for a short draft,
    one call per segment for a long one (see _SEMANTIC_SEGMENT_
    CHARS) — and merge the quote-verified findings. Quotes are
    always re-verified against the FULL draft. Raises
    SemanticUnavailable only when NO segment produced a parseable
    reply; a partially failed run returns its findings plus the
    per-segment errors so the gap is data, not silence."""
    draft = draft or ""
    segments = _split_draft_segments(draft)
    segmented = len(segments) > 1
    tail = _sources_tail(draft) if segmented else ""
    findings, dropped, seen = [], 0, set()
    model_verdict, lanes, errors = None, [], []
    ok = 0
    prompt_chars = 0
    for idx, seg_text in enumerate(segments):
        body = seg_text
        if tail and tail not in seg_text:
            body = seg_text + "\n\n" + tail
        note = ""
        if segmented:
            note = (f"This prompt carries SEGMENT {idx + 1} OF "
                    f"{len(segments)} of a long draft; the draft "
                    "is checked in segments and the findings are "
                    "merged. Judge THIS segment on its own — a "
                    "segment may end mid-argument, so never flag "
                    "incompleteness. If a SOURCES SECTION from "
                    "the same draft is appended after the segment, "
                    "sources named there count as named in the "
                    "draft. Quotes must be copied from THIS "
                    "segment.")
        try:
            prompt = build_semantic_prompt(
                body, question, segment_note=note)
            prompt_chars = max(prompt_chars, len(prompt))
            raw = caller(prompt)
            lane = None
            if isinstance(raw, tuple):
                raw, lane = raw
            f2, d2, mv2 = parse_semantic_reply(raw, draft)
        except Exception as ex:  # noqa: BLE001 - per-segment data
            errors.append(f"segmen {idx + 1}/{len(segments)}: "
                          f"{type(ex).__name__}: {ex}")
            continue
        ok += 1
        if lane and lane not in lanes:
            lanes.append(lane)
        if model_verdict is None:
            model_verdict = mv2
        dropped += d2
        for f in f2:
            key = (f["code"], f["sub"], _normalise_ws(f["quote"]))
            if key in seen:
                continue
            seen.add(key)
            findings.append(f)
            if len(findings) >= SEMANTIC_MAX_FINDINGS:
                break
    if ok == 0:
        raise SemanticUnavailable(
            " || ".join(errors) or "pemeriksa gagal di semua segmen")
    return {"findings": findings, "dropped": dropped,
            "model_verdict": model_verdict,
            "lane": "+".join(lanes) if lanes else None,
            "segments": len(segments), "segments_ok": ok,
            "prompt_chars": prompt_chars,
            "errors": errors}


def _with_novelty_context(question, isr_id):
    """Append the Surprise-Gauge novelty context (novelty_context:
    the question's existing VERIFIED answers, covered list +
    excerpts) to the checker question. Rides THIS stage's arming
    plus its own sub-flag (DIALECTICA_SEMANTIC_NOVELTY=0 switches
    the context off alone; default follows the parent flag). The
    isos fetch itself rides the serve gate's fetch arming, so an
    unarmed process touches no network. Advisory only: ANY failure
    returns the question unchanged (loud on stderr) — a novelty
    outage must never break, block or silently alter the check."""
    if not isr_id:
        return question
    try:
        import novelty_context
        if not novelty_context.novelty_enabled():
            return question
        block, meta = novelty_context.context_for_isr(isr_id)
        if block:
            print("serve_gate: konteks kebaruan C5 terlampir "
                  f"(isr {str(isr_id)[:8]}: {meta['verified_total']} "
                  f"verified, {meta['excerpted']} dikutip, "
                  f"{meta['block_chars']} kar"
                  f"{', DIPADATKAN' if meta.get('compacted') else ''})",
                  file=sys.stderr)
            return novelty_context.attach(question, block)
        if meta.get("state") == "failed":
            print("serve_gate: konteks kebaruan C5 GAGAL dibangun "
                  f"(isr {str(isr_id)[:8]}) — cek jalan tanpa "
                  "konteks kebaruan", file=sys.stderr)
        return question
    except Exception as ex:  # noqa: BLE001 - advisory stage
        print("serve_gate: konteks kebaruan C5 error "
              f"({type(ex).__name__}: {ex}) — cek jalan tanpa "
              "konteks kebaruan", file=sys.stderr)
        return question


def armed_semantic_check(question="", isr_id=None):
    """The C5 stage as `gate_answer` consumes it, or None when the
    launcher has not armed it (DIALECTICA_SEMANTIC_CHECK=1 —
    run_serve sets this for the gated Vyce serve, the same arming
    pattern as the liveness fetch). Unarmed callers (unit tests,
    manual provider runs) get the honest not-performed report,
    exactly as before C5. When an isr_id is present, the question
    first gains the novelty context (see _with_novelty_context):
    without the existing verified answers in context, the checker
    cannot judge SURPRISE_GAUGE at all (KALIBRASI-C5 §6 risk 4)."""
    if os.environ.get(SEMANTIC_ARM_ENV) != "1":
        return None
    question = _with_novelty_context(question, isr_id)

    def _check(text):
        return semantic_check(text, question=question, isr_id=isr_id)
    return _check


# ------------------------------------------------------------- the gate

def needs_json_from_prompt(prompt):
    """Mirror of vyce_provider's own schema-demand heuristic, so the
    serve gate scores format gate (g) the same way the Vyce pipeline
    already treats the job."""
    low = (prompt or "").lower()
    return (("json" in low and ("schema" in low or "output" in low
                                or "format" in low or "field" in low))
            or "structured_data" in low or "outcometype" in low
            or "credibleinterval" in low)


def gate_answer(text, regen_fn=None, semantic_check=None, **score_kwargs):
    """Run the claim wrapper over a serve draft and apply the serve
    layers. Returns the wrapper result dict plus:

    - result["sendable"]: the claim lanes' exact semantics — status
      OK + zero surviving audit findings (the report strips spans, so
      any finding counts, the deliberate fail-closed conservatism of
      §35/§37) + format gate (g) LOLOS — now computed over the
      findings WITH the thinking-trace layer merged in;
    - result["gate"]: {thinking_trace: bool,
      evasive_source_closing: bool, reasons: [...],
      semantic_vfp: {...}} — the semantic self-VFP is reported as
      NOT performed unless a `semantic_check` callable is supplied.
      A callable returning the C5 structured dict (see
      `semantic_check`) withholds the draft ONLY through its
      `block` flag (mode "block" + fatal verdict); in shadow mode
      it can never withhold. A callable returning a plain bool
      keeps the original injected-check semantics (falsy withholds).
    """
    result = wrap_answer(text, regen_fn=regen_fn, **score_kwargs)
    trace = detect_thinking_trace(result["text"])
    audit = result["report"]["audit"]
    if trace:
        audit["findings"].extend(
            {k: v for k, v in f.items() if k != "span"} for f in trace)
        audit["thinking_trace"] = len(trace)
    else:
        audit["thinking_trace"] = 0
    e3 = detect_evasive_source_closing(result["text"])
    if e3:
        audit["findings"].extend(
            {k: v for k, v in f.items() if k != "span"} for f in e3)
        audit["evasive_source_closing"] = len(e3)
    else:
        audit["evasive_source_closing"] = 0
    findings = audit["findings"]
    unpatchable = [f for f in findings if not f.get("span")]
    result["sendable"] = (
        result["status"] == "OK" and not unpatchable
        and result["score"]["g"][0] == "LOLOS")
    reasons = []
    if result["status"] != "OK":
        reasons.append(f"status wrapper {result['status']} "
                       f"(panjang di bawah lantai sesudah regenerasi)")
    for f in findings:
        reasons.append(f"{f.get('severity')}: {f.get('action')}")
    if result["score"]["g"][0] != "LOLOS":
        reasons.append(f"gerbang format (g) GAGAL: "
                       f"{result['score']['g'][1]}")
    semantic = {"performed": False,
                "mode": "not-performed-mechanical-only",
                "note": "self-VFP semantik (T10.2/T12 butir 5) "
                        "adalah penilaian agen di jalur klaim, "
                        "bukan panggilan model di dalam wrapper — "
                        "serve latar tidak punya agen di lingkaran, "
                        "jadi gerbang ini TIDAK mengklaimnya lolos; "
                        "keputusan lab diperlukan (lihat laporan)"}
    if semantic_check is not None:
        try:
            verdict = semantic_check(result["text"])
        except Exception as ex:  # noqa: BLE001 - a crashed checker
            # must never kill a good draft (RANCANGAN-C5 §3): the
            # stage reports itself unperformed and does not block.
            verdict = {"performed": False,
                       "mode": "injected-check-error",
                       "verdict": "unavailable", "findings": [],
                       "block": False,
                       "error": f"{type(ex).__name__}: {ex}"}
        if isinstance(verdict, dict):
            semantic = {
                "performed": bool(verdict.get("performed")),
                "mode": verdict.get("mode", "injected-check"),
                "checker": verdict.get("checker"),
                "verdict": verdict.get("verdict"),
                "findings": verdict.get("findings", []),
                "dropped_findings": verdict.get("dropped_findings", 0),
                "block": bool(verdict.get("block")),
                "error": verdict.get("error"),
            }
            if verdict.get("block"):
                result["sendable"] = False
                reasons.append(
                    "cek semantik C5 (mode block): temuan fatal "
                    "menahan draf ("
                    f"{len(verdict.get('findings', []))} temuan "
                    "P/S berkuotasi terverifikasi)")
        else:
            semantic = {"performed": True, "mode": "injected-check",
                        "verdict": verdict}
            if not verdict:
                result["sendable"] = False
                reasons.append("cek semantik injeksi: TIDAK lolos")
    result["gate"] = {
        "thinking_trace": bool(trace),
        "trace_signals": [f["action"] for f in trace],
        "evasive_source_closing": bool(e3),
        "e3_signals": [f["action"] for f in e3],
        "semantic_vfp": semantic,
        "reasons": reasons,
    }
    return result
